{
  "name": "gravityborn",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/offline-build.mjs",
    "icons": "node scripts/icons.mjs",
    "native:sync": "npm run build && cap sync && node scripts/native-prepare.mjs",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4180 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "playtest": "node scripts/playtest.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.58.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
