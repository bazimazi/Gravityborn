{
  "name": "gravityborn",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4180 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "playtest": "node scripts/playtest.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "format": "prettier --write src tests scripts *.ts *.json",
    "format:check": "prettier --check src tests scripts *.ts *.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "matter-js": "0.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
